<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Posicionamiento div</title>
    <style>
      div {
        width: 15rem;
        height: 20rem;
        border: 5px solid black;
        color: white;
        font-size: 3em;
        padding: 1em;
        box-sizing: border-box;
        display: inline-block;
      }

      div:nth-child(1) {
        background-color: black;
        position: relative;
        z-index:5;

      }

      div:nth-child(2) {
        background-color: rgb(147, 137, 137);
        position: relative;
        top: 50px;
        right: 150px;
        z-index:4;
      }
      div:nth-child(3) {
        background-color: antiquewhite;
        position: relative;
        top: 100px;
        right: 300px;
        z-index:3;
      }
      div:nth-child(4) {
        background-color: darkmagenta;
        position: relative;
        top: 150px;
        right: 450px;
        z-index:2;
      }
      div:nth-child(5) {
        background-color: chocolate;
        position: relative;
        top: 200px;
        right: 500px;
        z-index:1;
      }
    
    </style>
  </head>
  <body>
    <div>1</div>
    <div>2</div>
    <div>3</div>
    <div>4</div>
    <div>5</div>
  </body>
</html>
